{
  "retrieval": {
    "backend": "hybrid_qdrant",
    "bm25_index": "data/indices/bm25_index.json",
    "lexical_index": "data/indices/articles_fts.sqlite",
    "articles": "data/normalized/articles.jsonl",
    "bm25_top_k": 40,
    "vector_top_k": 32,
    "fusion_top_k": 28,
    "rerank_top_k": 16,
    "final_top_k": 8,
    "rerank_weight": 0.7,
    "fusion_weight": 0.2,
    "structured_weight": 0.1,
    "min_score_ratio": 0.08,
    "enable_margin_cutoff": true,
    "margin_delta": 0.18,
    "min_articles_after_cutoff": 2,
    "max_articles_after_cutoff": 8,
    "graph_expand_top_k": 14,
    "index_node_types": [
      "article",
      "clause"
    ],
    "enable_micro_chunks": false,
    "max_payload_text_chars": 8000,
    "upsert_batch_size": 128,
    "load_bm25": false
  },
  "planning": {
    "enabled": true,
    "model": "qwen3:8b-q8_0",
    "ollama_url": "http://127.0.0.1:11434/api/chat",
    "max_queries": 3,
    "max_tokens": 280,
    "num_ctx": 8192,
    "think": false,
    "keep_alive": "30m",
    "require_json": true,
    "response_format_json": true
  },
  "embedding": {
    "model": "BAAI/bge-m3",
    "local_path": "",
    "local_files_only": true,
    "cache_dir": "data/indices/embedding_cache",
    "batch_size": 4,
    "max_encode_chars": 12000
  },
  "reranker": {
    "model": "BAAI/bge-reranker-v2-m3",
    "local_path": "",
    "local_files_only": true,
    "max_chars": 3200,
    "simple_max_length": 640,
    "complex_max_length": 1024,
    "batch_size": 4
  },
  "qdrant": {
    "url": "http://127.0.0.1:6333",
    "path": "",
    "max_embedded_points": 20000,
    "collection": "r2ai_law_articles_v2"
  },
  "lexicon": {
    "path": "data/indices/legal_lexicon.sqlite",
    "top_k": 4
  },
  "generation": {
    "backend": "ollama",
    "target_model": "qwen3:8b-q8_0",
    "ollama_url": "http://127.0.0.1:11434/api/chat",
    "max_tokens": 520,
    "num_ctx": 12288,
    "think": false,
    "keep_alive": "30m",
    "response_format_json": true,
    "max_context_articles": 6,
    "final_relevant_articles_max": 5
  },
  "verifier": {
    "require_planner": true,
    "require_used_evidence": true,
    "block_on_issues": true,
    "enable_repair": false
  },
  "submission": {
    "required_filename": "results.json",
    "zip_root_only": true
  }
}
