{
  "retrieval": {
    "backend": "hybrid_qdrant",
    "bm25_index": "data/indices/bm25_index.json",
    "articles": "data/normalized/articles.jsonl",
    "bm25_top_k": 80,
    "vector_top_k": 80,
    "fusion_top_k": 50,
    "rerank_top_k": 30,
    "final_top_k": 8,
    "min_score_ratio": 0.08,
    "enable_margin_cutoff": true,
    "margin_delta": 0.18,
    "min_articles_after_cutoff": 2,
    "max_articles_after_cutoff": 6,
    "graph_expand_top_k": 24,
    "index_node_types": ["article", "clause"],
    "enable_micro_chunks": false,
    "max_payload_text_chars": 20000,
    "upsert_batch_size": 512,
    "load_bm25": false
  },
  "planning": {
    "enabled": true,
    "model": "qwen3:8b-q8_0",
    "ollama_url": "http://127.0.0.1:11434/v1/chat/completions",
    "max_queries": 3,
    "max_tokens": 520,
    "require_json": true
  },
  "embedding": {
    "model": "BAAI/bge-m3",
    "local_path": "",
    "local_files_only": false,
    "cache_dir": "data/indices/embedding_cache",
    "batch_size": 16,
    "max_encode_chars": 12000
  },
  "reranker": {
    "model": "BAAI/bge-reranker-v2-m3",
    "local_path": "",
    "local_files_only": false
  },
  "qdrant": {
    "url": "http://127.0.0.1:6333",
    "path": "data/indices/qdrant",
    "collection": "r2ai_law_articles_v1"
  },
  "generation": {
    "backend": "ollama",
    "target_model": "qwen3:8b-q8_0",
    "ollama_url": "http://127.0.0.1:11434/v1/chat/completions",
    "max_tokens": 520,
    "max_context_articles": 8,
    "final_relevant_articles_max": 5
  },
  "verifier": {
    "require_planner": true,
    "require_used_evidence": true,
    "block_on_issues": true,
    "enable_repair": false
  },
  "submission": {
    "required_filename": "results.json",
    "zip_root_only": true
  }
}
